<body>
  <header>
    <h1>Compliance Screening Bot</h1>
    <p>Screening Results & Analysis</p>
  </header>

  <nav>
    <a href="/">Dashboard</a>
    <a href="/results" class="active">Results</a>
    <a href="/alerts">Alerts</a>
  </nav>

  <div class="container">
    <div class="card">
      <h2>Results Summary</h2>
      <div class="stats" id="statsContainer">
        <div class="stat-card">
          <h3 id="totalResults">0</h3>
          <p>Total Results</p>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
          <h3 id="totalFound">0</h3>
          <p>Found</p>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
          <h3 id="totalNotFound">0</h3>
          <p>Not Found</p>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Filter Results</h2>
      <div class="filters">
        <select id="platformFilter">
          <option value="">All Platforms</option>
          <option value="opensanctions">OpenSanctions</option>
          <option value="hhs">HHS Exclusions</option>
        </select>

        <select id="foundFilter">
          <option value="">All Results</option>
          <option value="true">Found</option>
          <option value="false">Not Found</option>
        </select>

        <select id="monthFilter">
          <option value="">All Months</option>
          <option value="1">January</option>
          <option value="2">February</option>
          <option value="3">March</option>
          <option value="4">April</option>
          <option value="5">May</option>
          <option value="6">June</option>
          <option value="7">July</option>
          <option value="8">August</option>
          <option value="9">September</option>
          <option value="10">October</option>
          <option value="11">November</option>
          <option value="12">December</option>
        </select>

        <button onclick="applyFilters()">Apply Filters</button>
        <button class="secondary" onclick="downloadCSV()">Download CSV</button>
      </div>
    </div>

    <div class="card">
      <h2>Screening Results</h2>
      <table id="resultsTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Platform</th>
            <th>Status</th>
            <th>Date</th>
            <th>PDF</th>
          </tr>
        </thead>
        <tbody id="resultsBody">
          <tr>
            <td colspan="5" class="no-results">Loading results...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    let allResults = [];

    async function loadResults() {
      try {
        const response = await fetch('/api/upload');
        const uploads = await response.json();

        // Flatten all results from all uploads
        allResults = [];
        uploads.forEach(upload => {
          if (upload.results && upload.results.length > 0) {
            upload.results.forEach(result => {
              allResults.push({
                ...result,
                uploadId: upload._id,
                month: upload.month,
                year: upload.year,
                searchDate: result.checkedAt || upload.uploadDate
              });
            });
          }
        });

        displayResults(allResults);
        updateStats();
      } catch (error) {
        console.error('Error loading results:', error);
        document.getElementById('resultsBody').innerHTML =
          '<tr><td colspan="5" class="no-results">Error loading results</td></tr>';
      }
    }

    function displayResults(results) {
      const tbody = document.getElementById('resultsBody');

      if (results.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="no-results">No results found</td></tr>';
        return;
      }

      let html = '';
      results.forEach((result) => {
        const statusBadge = result.found
          ? '<span class="status-badge status-found">FOUND</span>'
          : '<span class="status-badge status-not-found">NOT FOUND</span>';

        const date = new Date(result.searchDate).toLocaleDateString();

        // PDF download links
        let pdfLinks = '';
        if (result.pdfUrl) {
          pdfLinks = `
            <div class="pdf-links">
              <a href="${result.pdfUrl}" target="_blank" class="btn view" title="View PDF">View</a>
              <a href="${result.pdfUrl}" download class="btn download" title="Download PDF">Download</a>
            </div>
          `;
        } else {
          pdfLinks = '<span style="color: #999; font-size: 12px;">No PDF</span>';
        }

        html += `
          <tr>
            <td><strong>${result.name}</strong></td>
            <td><span class="platform-badge">${result.platform.toUpperCase()}</span></td>
            <td>${statusBadge}</td>
            <td>${date}</td>
            <td>${pdfLinks}</td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
    }

    async function updateStats() {
      const total = allResults.length;
      const found = allResults.filter(r => r.found).length;
      const notFound = total - found;

      document.getElementById('totalResults').textContent = total;
      document.getElementById('totalFound').textContent = found;
      document.getElementById('totalNotFound').textContent = notFound;
    }

    function applyFilters() {
      const platform = document.getElementById('platformFilter').value;
      const found = document.getElementById('foundFilter').value;
      const month = document.getElementById('monthFilter').value;

      let filtered = allResults;

      if (platform) filtered = filtered.filter((r) => r.platform === platform);
      if (found !== '') filtered = filtered.filter((r) => r.found === (found === 'true'));
      if (month) filtered = filtered.filter((r) => r.month === parseInt(month));

      displayResults(filtered);
      
      // Update stats for filtered results
      const total = filtered.length;
      const foundCount = filtered.filter(r => r.found).length;
      const notFound = total - foundCount;

      document.getElementById('totalResults').textContent = total;
      document.getElementById('totalFound').textContent = foundCount;
      document.getElementById('totalNotFound').textContent = notFound;
    }

    function downloadCSV() {
      if (allResults.length === 0) {
        alert('No results to download');
        return;
      }

      let csv = 'Name,Platform,Status,Date,PDF URL\n';

      allResults.forEach((result) => {
        const status = result.found ? 'FOUND' : 'NOT FOUND';
        const date = new Date(result.searchDate).toLocaleDateString();
        const pdfUrl = result.pdfUrl || 'N/A';

        csv += `"${result.name}","${result.platform}","${status}","${date}","${pdfUrl}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `screening_results_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
      window.URL.revokeObjectURL(url);
    }

    // Load results on page load
    loadResults();

    // Refresh every 30 seconds
    setInterval(loadResults, 30000);
  </script>
</body>
</html>
