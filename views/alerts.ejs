  <script>
    let allAlerts = [];
    let currentPage = 1;
    const alertsPerPage = 25;

    async function loadAlerts() {
      try {
        const month = document.getElementById('filterMonth').value;
        const year = document.getElementById('filterYear').value;

        let url = '/api/results/alerts';
        const params = new URLSearchParams();

        if (month) params.append('month', month);
        if (year) params.append('year', year);

        if (params.toString()) {
          url += '?' + params.toString();
        }

        const response = await fetch(url);
        allAlerts = await response.json();

        currentPage = 1;
        displayPage();
        loadStats();
      } catch (error) {
        console.error('Error loading alerts:', error);
        document.getElementById('alertsContainer').innerHTML =
          '<div class="no-data">Error loading alerts</div>';
      }
    }

    function displayPage() {
      const start = (currentPage - 1) * alertsPerPage;
      const end = start + alertsPerPage;
      const pageAlerts = allAlerts.slice(start, end);

      document.getElementById('resultCount').textContent = `Showing ${allAlerts.length} alert(s)`;

      if (pageAlerts.length === 0) {
        document.getElementById('alertsContainer').innerHTML =
          '<div class="no-data">No alerts found</div>';
        updatePaginationButtons();
        return;
      }

      let html = `
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Platforms Found</th>
              <th>Date</th>
              <th>Email Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
      `;

      pageAlerts.forEach((alert) => {
        const date = new Date(alert.alertDate).toLocaleDateString();
        const platformBadges = alert.platforms
          .map((p) => `<span class="platform-badge">${p}</span>`)
          .join('');
        const emailStatus = alert.emailSent
          ? '<span class="email-status sent">Sent</span>'
          : '<span class="email-status pending">Pending</span>';

        html += `
          <tr class="alert-row">
            <td><strong>${alert.name}</strong></td>
            <td>${platformBadges}</td>
            <td>${date}</td>
            <td>${emailStatus}</td>
            <td>
              ${!alert.emailSent ? `<button class="action-btn" onclick="markAsSent('${alert._id}')">Mark Sent</button>` : ''}
            </td>
          </tr>
        `;
      });

      html += `
          </tbody>
        </table>
      `;

      document.getElementById('alertsContainer').innerHTML = html;
      updatePaginationButtons();
    }

    async function loadStats() {
      try {
        const month = document.getElementById('filterMonth').value;
        const year = document.getElementById('filterYear').value;

        let url = '/api/results/alerts/summary';
        const params = new URLSearchParams();

        if (month) params.append('month', month);
        if (year) params.append('year', year);

        if (params.toString()) {
          url += '?' + params.toString();
        }

        const response = await fetch(url);
        const summary = await response.json();

        document.getElementById('totalAlerts').textContent = summary.totalAlerts;
        document.getElementById('emailsSent').textContent = summary.emailsSent;
        document.getElementById('uniqueNames').textContent = allAlerts.length;
      } catch (error) {
        console.error('Error loading stats:', error);
      }
    }

    function updatePaginationButtons() {
      const totalPages = Math.ceil(allAlerts.length / alertsPerPage);
      document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages || 1}`;
      document.getElementById('prevBtn').disabled = currentPage === 1;
      document.getElementById('nextBtn').disabled = currentPage >= totalPages;
    }

    function previousPage() {
      if (currentPage > 1) {
        currentPage--;
        displayPage();
        window.scrollTo(0, 0);
      }
    }

    function nextPage() {
      const totalPages = Math.ceil(allAlerts.length / alertsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        displayPage();
        window.scrollTo(0, 0);
      }
    }

    async function markAsSent(alertId) {
      try {
        const response = await fetch(`/api/results/alerts/${alertId}/sent`, {
          method: 'PUT',
        });

        if (response.ok) {
          loadAlerts();
        } else {
          alert('Error marking alert as sent');
        }
      } catch (error) {
        console.error('Error:', error);
      }
    }

    function exportAlerts() {
      if (allAlerts.length === 0) {
        alert('No alerts to export');
        return;
      }

      let csv = 'Name,Platforms,Date,Email Sent\n';

      allAlerts.forEach((alert) => {
        const date = new Date(alert.alertDate).toLocaleDateString();
        const platforms = alert.platforms.join('; ');
        const emailSent = alert.emailSent ? 'Yes' : 'No';

        csv += `"${alert.name}","${platforms}","${date}","${emailSent}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `alerts_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
      window.URL.revokeObjectURL(url);
    }

    // Load alerts on page load
    loadAlerts();

    // Refresh alerts every 10 seconds
    setInterval(loadAlerts, 10000);
  </script>
</body>
</html> -->



