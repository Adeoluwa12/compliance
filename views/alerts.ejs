<body>
  <header>
    <h1>Compliance Screening Bot</h1>
    <p>Government Exclusion Database Monitor</p>
  </header>

  <nav>
    <a href="/">Dashboard</a>
    <a href="/results">Results</a>
    <a href="/alerts">Alerts</a>
  </nav>

  <div class="container">
    <div class="card">
      <h2>Alert Statistics</h2>
      <div class="stats" id="statsContainer">
        <div class="stat-card">
          <h3 id="totalAlerts">0</h3>
          <p>Total Alerts</p>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
          <h3 id="uniqueNames">0</h3>
          <p>Unique Names Found</p>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
          <h3 id="totalPDFs">0</h3>
          <p>PDFs Available</p>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Alerts</h2>

      <div class="filters">
        <div class="form-group">
          <label for="filterMonth">Filter by Month</label>
          <select id="filterMonth">
            <option value="">All Months</option>
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
          </select>
        </div>

        <div class="form-group">
          <label for="filterYear">Filter by Year</label>
          <input type="number" id="filterYear" min="2020" max="2099" placeholder="All Years">
        </div>

        <div style="display: flex; align-items: flex-end; gap: 15px;">
          <button onclick="loadAlerts()" style="width: auto; padding: 10px 20px;">Apply Filters</button>
          <button onclick="exportAlerts()" class="export-btn">Export CSV</button>
        </div>
      </div>

      <div class="result-count" id="resultCount"></div>

      <div id="alertsContainer">
        <div class="no-data">Loading alerts...</div>
      </div>

      <div class="pagination">
        <button id="prevBtn" onclick="previousPage()" style="width: auto; padding: 8px 12px;">Previous</button>
        <span id="pageInfo" style="align-self: center; color: #666;"></span>
        <button id="nextBtn" onclick="nextPage()" style="width: auto; padding: 8px 12px;">Next</button>
      </div>
    </div>
  </div>

  <script>
    let allAlerts = [];
    let currentPage = 1;
    const alertsPerPage = 25;

    async function loadAlerts() {
      try {
        const month = document.getElementById('filterMonth').value;
        const year = document.getElementById('filterYear').value;

        // Load all uploads and filter for alerts (names that were found)
        const response = await fetch('/api/upload');
        const uploads = await response.json();

        allAlerts = [];

        uploads.forEach(upload => {
          if (upload.results && upload.results.length > 0) {
            // Group results by name for this upload
            const foundByName = {};
            
            upload.results.forEach(result => {
              if (result.found) {
                if (!foundByName[result.name]) {
                  foundByName[result.name] = {
                    name: result.name,
                    platforms: [],
                    pdfs: [],
                    month: upload.month,
                    year: upload.year,
                    alertDate: result.checkedAt || upload.uploadDate
                  };
                }
                foundByName[result.name].platforms.push(result.platform);
                if (result.pdfUrl) {
                  foundByName[result.name].pdfs.push({
                    platform: result.platform,
                    url: result.pdfUrl
                  });
                }
              }
            });

            // Add to all alerts
            Object.values(foundByName).forEach(alert => {
              // Apply filters
              const monthMatch = !month || alert.month === parseInt(month);
              const yearMatch = !year || alert.year === parseInt(year);
              
              if (monthMatch && yearMatch) {
                allAlerts.push(alert);
              }
            });
          }
        });

        currentPage = 1;
        displayPage();
        loadStats();
      } catch (error) {
        console.error('Error loading alerts:', error);
        document.getElementById('alertsContainer').innerHTML =
          '<div class="no-data">Error loading alerts</div>';
      }
    }

    function displayPage() {
      const start = (currentPage - 1) * alertsPerPage;
      const end = start + alertsPerPage;
      const pageAlerts = allAlerts.slice(start, end);

      document.getElementById('resultCount').textContent = `Showing ${allAlerts.length} alert(s)`;

      if (pageAlerts.length === 0) {
        document.getElementById('alertsContainer').innerHTML =
          '<div class="no-data">No alerts found</div>';
        updatePaginationButtons();
        return;
      }

      let html = `
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Platforms Found</th>
              <th>Date</th>
              <th>PDFs</th>
            </tr>
          </thead>
          <tbody>
      `;

      pageAlerts.forEach((alert) => {
        const date = new Date(alert.alertDate).toLocaleDateString();
        const platformBadges = alert.platforms
          .map((p) => `<span class="platform-badge">${p.toUpperCase()}</span>`)
          .join('');

        let pdfLinks = '';
        if (alert.pdfs && alert.pdfs.length > 0) {
          pdfLinks = '<div class="pdf-links">';
          alert.pdfs.forEach(pdf => {
            pdfLinks += `
              <a href="${pdf.url}" target="_blank" class="btn view" title="View ${pdf.platform} PDF">
                ${pdf.platform.toUpperCase()}
              </a>
            `;
          });
          pdfLinks += '</div>';
        } else {
          pdfLinks = '<span style="color: #999; font-size: 12px;">No PDFs</span>';
        }

        html += `
          <tr class="alert-row">
            <td><strong>${alert.name}</strong></td>
            <td>${platformBadges}</td>
            <td>${date}</td>
            <td>${pdfLinks}</td>
          </tr>
        `;
      });

      html += `
          </tbody>
        </table>
      `;

      document.getElementById('alertsContainer').innerHTML = html;
      updatePaginationButtons();
    }

    async function loadStats() {
      const uniqueNames = new Set(allAlerts.map(a => a.name)).size;
      const totalPDFs = allAlerts.reduce((sum, alert) => sum + (alert.pdfs ? alert.pdfs.length : 0), 0);

      document.getElementById('totalAlerts').textContent = allAlerts.length;
      document.getElementById('uniqueNames').textContent = uniqueNames;
      document.getElementById('totalPDFs').textContent = totalPDFs;
    }

    function updatePaginationButtons() {
      const totalPages = Math.ceil(allAlerts.length / alertsPerPage);
      document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages || 1}`;
      document.getElementById('prevBtn').disabled = currentPage === 1;
      document.getElementById('nextBtn').disabled = currentPage >= totalPages;
    }

    function previousPage() {
      if (currentPage > 1) {
        currentPage--;
        displayPage();
        window.scrollTo(0, 0);
      }
    }

    function nextPage() {
      const totalPages = Math.ceil(allAlerts.length / alertsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        displayPage();
        window.scrollTo(0, 0);
      }
    }

    function exportAlerts() {
      if (allAlerts.length === 0) {
        alert('No alerts to export');
        return;
      }

      let csv = 'Name,Platforms,Date,PDF Count,PDF URLs\n';

      allAlerts.forEach((alert) => {
        const date = new Date(alert.alertDate).toLocaleDateString();
        const platforms = alert.platforms.join('; ');
        const pdfCount = alert.pdfs ? alert.pdfs.length : 0;
        const pdfUrls = alert.pdfs ? alert.pdfs.map(p => p.url).join('; ') : 'N/A';

        csv += `"${alert.name}","${platforms}","${date}","${pdfCount}","${pdfUrls}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `alerts_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
      window.URL.revokeObjectURL(url);
    }

    // Load alerts on page load
    loadAlerts();

    // Refresh alerts every 10 seconds
    setInterval(loadAlerts, 10000);
  </script>
</body>
</html>
