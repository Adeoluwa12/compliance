    .btn.download:hover { background-color: #229954; }
    .btn.view { background-color: #e67e22; padding: 8px 16px; font-size: 12px; }
    .btn.view:hover { background-color: #d35400; }
    .btn.bulk { background-color: #9b59b6; padding: 10px 20px; }
    .btn.bulk:hover { background-color: #8e44ad; }
    .alert { padding: 12px; border-radius: 4px; margin-bottom: 15px; }
    .alert.success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .alert.error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
