      font-weight: bold;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      margin-bottom: 20px;
    }

    .stat-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 20px;
      border-radius: 8px;
      text-align: center;
    }

    .stat-card h3 {
      font-size: 24px;
      margin-bottom: 5px;
    }

    .stat-card p {
      font-size: 12px;
      opacity: 0.9;
    }

    .pdf-list {
      display: grid;
      gap: 10px;
      margin-top: 15px;
    }

    .pdf-item {
      display: grid;
      grid-template-columns: 1fr auto auto auto;
      gap: 15px;
      align-items: center;
      padding: 15px;
      background-color: #f9f9f9;
      border-radius: 6px;
      border-left: 4px solid #3498db;
    }

    .pdf-item.found {
      border-left-color: #e74c3c;
      background-color: #fff5f5;
    }

    .pdf-name {
      font-size: 14px;
    }

    .pdf-name strong {
      color: #2c3e50;
      display: block;
      margin-bottom: 4px;
    }

    .pdf-status {
      padding: 6px 12px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      background-color: #d4edda;
      color: #155724;
    }

    .pdf-status.found {
      background-color: #f8d7da;
      color: #721c24;
    }

    .platform-badge {
      padding: 4px 8px;
      background-color: #ecf0f1;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 500;
      color: #34495e;
    }

    .pdf-actions {
      display: flex;
      gap: 8px;
    }

    .pdf-filter {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
      align-items: center;
      flex-wrap: wrap;
    }

    .pdf-filter select {
      width: auto;
      min-width: 150px;
    }

    .pdf-filter label {
      margin-bottom: 0;
      font-size: 14px;
    }

    .upload-actions {
      display: flex;
      gap: 8px;
      justify-content: flex-end;
    }

    .upload-actions .btn {
      font-size: 12px;
      padding: 6px 12px;
    }

    .no-pdf {
      color: #999;
      font-size: 12px;
      font-style: italic;
    }
  </style>
</head>
<body>
  <header>
    <h1>Compliance Screening Bot</h1>
    <p>Government Exclusion Database Monitor</p>
  </header>

  <nav>
    <a href="/">Dashboard</a>
    <a href="/results">Results</a>
    <a href="/alerts">Alerts</a>
  </nav>

  <div class="container">
    <div class="card">
      <h2>Upload Excel File</h2>
      <form id="uploadForm" enctype="multipart/form-data">
        <div class="form-group">
          <label for="file">Select Excel File (.xlsx, .xls)</label>
          <input type="file" id="file" name="file" accept=".xlsx,.xls" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <div class="form-group">
            <label for="month">Month</label>
            <select id="month" name="month" required>
              <option value="">Select Month</option>
              <option value="1">January</option>
              <option value="2">February</option>
              <option value="3">March</option>
              <option value="4">April</option>
              <option value="5">May</option>
              <option value="6">June</option>
              <option value="7">July</option>
              <option value="8">August</option>
              <option value="9">September</option>
              <option value="10">October</option>
              <option value="11">November</option>
              <option value="12">December</option>
            </select>
          </div>

          <div class="form-group">
            <label for="year">Year</label>
            <input type="number" id="year" name="year" min="2020" max="2099" required placeholder="2024">
          </div>
        </div>

        <div class="button-group">
          <button type="submit">Upload & Start Screening</button>
        </div>
      </form>

      <div id="uploadResult" style="display: none; margin-top: 15px;"></div>
    </div>

    <div class="card">
      <h2>Processing Monitor</h2>
      <div id="progressContainer" style="display: none;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
          <span id="progressLabel"></span>
          <span id="progressPercent">0%</span>
        </div>
        <div class="progress-bar">
          <div class="progress-fill" id="mainProgress" style="width: 0%;"></div>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Recent Uploads</h2>
      <div id="uploadsContainer">
        <p>Loading uploads...</p>
      </div>
    </div>

    <div class="card" id="pdfsCard" style="display: none;">
      <h2>Download Search Results (PDFs)</h2>
      
      <div class="pdf-filter">
        <label>Filter:</label>
        <select id="pdfPlatformFilter" onchange="filterPDFs()">
          <option value="">All Platforms</option>
          <option value="opensanctions">OpenSanctions</option>
          <option value="hhs">HHS Exclusions</option>
        </select>
        
        <select id="pdfStatusFilter" onchange="filterPDFs()">
          <option value="">All Results</option>
          <option value="found">Found Only</option>
          <option value="not-found">Not Found Only</option>
        </select>
      </div>

      <div id="pdfCount" style="color: #666; font-size: 13px; margin-bottom: 10px;"></div>
      
      <div id="pdfListContainer">
        <p style="text-align: center; padding: 20px; color: #999;">Loading PDFs...</p>
      </div>
    </div>

    <div class="card">
      <h2>Quick Stats</h2>
      <div class="stats">
        <div class="stat-card">
          <h3 id="totalUploads">0</h3>
          <p>Total Uploads</p>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
          <h3 id="totalAlerts">0</h3>
          <p>Names Found</p>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
          <h3 id="totalProcessed">0</h3>
          <p>Total Processed</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const uploadForm = document.getElementById('uploadForm');
    const uploadResult = document.getElementById('uploadResult');
    let progressInterval = null;
    let currentUploadId = null;
    let allPDFs = [];
    let filteredPDFs = [];

    uploadForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(uploadForm);

      try {
        const response = await fetch('/api/upload', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (response.ok) {
          currentUploadId = data.uploadId;
          showResult('success', `File uploaded successfully! Starting to screen ${data.totalNames} names...`);
          uploadForm.reset();

          document.getElementById('progressContainer').style.display = 'block';
          document.getElementById('progressLabel').textContent = `Processing ${data.totalNames} names...`;

          startProgressMonitoring(data.uploadId, data.totalNames);
          loadUploads();
        } else {
          showResult('error', data.error || 'Upload failed');
        }
      } catch (error) {
        showResult('error', `Error: ${error.message}`);
      }
    });

    function showResult(type, message) {
      uploadResult.innerHTML = `<div class="alert ${type}">${message}</div>`;
      uploadResult.style.display = 'block';

      if (type === 'success') {
        setTimeout(() => {
          uploadResult.style.display = 'none';
        }, 5000);
      }
    }

    function startProgressMonitoring(uploadId, totalNames) {
      if (progressInterval) {
        clearInterval(progressInterval);
      }

      progressInterval = setInterval(async () => {
        try {
          const response = await fetch(`/api/upload/${uploadId}`);
          const upload = await response.json();

          const percentage = totalNames > 0 ? Math.round((upload.processedNames / totalNames) * 100) : 0;

          document.getElementById('mainProgress').style.width = percentage + '%';
          document.getElementById('progressPercent').textContent = percentage + '%';
          document.getElementById('progressLabel').textContent = `Processing: ${upload.processedNames}/${totalNames} names`;

          if (upload.status === 'completed' || upload.status === 'failed') {
            clearInterval(progressInterval);
            if (upload.status === 'completed') {
              showResult('success', 'Screening completed!');
              loadUploads();
              setTimeout(() => loadPDFs(uploadId), 1000);
            } else {
              showResult('error', `Screening failed: ${upload.errorMessage}`);
            }
          }
        } catch (error) {
          console.error('Error monitoring progress:', error);
        }
      }, 1000);
    }

    async function loadUploads() {
      try {
        const response = await fetch('/api/upload');
        const uploads = await response.json();

        if (uploads.length === 0) {
          document.getElementById('uploadsContainer').innerHTML = '<p>No uploads yet</p>';
          return;
        }

        let html = `
          <table>
            <thead>
              <tr>
                <th>File Name</th>
                <th>Month/Year</th>
                <th>Total Names</th>
                <th>Processed</th>
                <th>Status</th>
                <th>Upload Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
        `;

        uploads.forEach((upload) => {
          const uploadDate = new Date(upload.uploadDate).toLocaleDateString();
          const percentage = upload.totalNames > 0 ? Math.round((upload.processedNames / upload.totalNames) * 100) : 0;

          html += `
            <tr>
              <td>${upload.filename}</td>
              <td>${upload.month}/${upload.year}</td>
              <td>${upload.totalNames}</td>
              <td>
                ${upload.processedNames}/${upload.totalNames}
                <div class="progress-bar" style="width: 100%; margin: 5px 0;">
                  <div class="progress-fill" style="width: ${percentage}%">${percentage}%</div>
                </div>
              </td>
              <td><span class="status ${upload.status}">${upload.status}</span></td>
              <td>${uploadDate}</td>
              <td>
                <div class="upload-actions">
                  ${upload.status === 'completed' ? `<a href="#pdfs" onclick="loadPDFs('${upload._id}'); return false;" class="btn view">View PDFs</a>` : ''}
                </div>
              </td>
            </tr>
          `;
        });

        html += `
            </tbody>
          </table>
        `;

        document.getElementById('uploadsContainer').innerHTML = html;

        const totalNames = uploads.reduce((sum, u) => sum + u.totalNames, 0);
        document.getElementById('totalUploads').textContent = uploads.length;
        document.getElementById('totalProcessed').textContent = totalNames;

        loadAlertStats();
      } catch (error) {
        console.error('Error loading uploads:', error);
      }
    }

    async function loadPDFs(uploadId) {
      try {
        console.log('[DEBUG] Loading PDFs for upload:', uploadId);
        
        const response = await fetch(`/api/upload/${uploadId}`);
        const upload = await response.json();

        console.log('[DEBUG] Upload data:', upload);
        console.log('[DEBUG] Results count:', upload.results?.length || 0);

        if (!upload.results || upload.results.length === 0) {
          console.warn('[DEBUG] No results found');
          alert('No results available for this upload yet.');
          document.getElementById('pdfsCard').style.display = 'none';
          return;
        }

        // Filter for results that have PDFs
        allPDFs = upload.results.filter(r => r.pdfUrl && r.pdfUrl.trim() !== '');
        
        console.log('[DEBUG] Total results:', upload.results.length);
        console.log('[DEBUG] Results with PDFs:', allPDFs.length);
        
        if (allPDFs.length > 0) {
          console.log('[DEBUG] Sample PDF URL:', allPDFs[0].pdfUrl);
        }
        
        if (allPDFs.length === 0) {
          alert('PDFs are still being generated. Please wait and try again in a moment.');
          document.getElementById('pdfsCard').style.display = 'none';
          return;
        }

        document.getElementById('pdfsCard').style.display = 'block';
        filteredPDFs = [...allPDFs];
        displayPDFs();

        // Scroll to PDFs section
        document.getElementById('pdfsCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) {
        console.error('[ERROR] Loading PDFs:', error);
        alert('Error loading PDFs. Please check the console for details.');
      }
    }

    function filterPDFs() {
      const platformFilter = document.getElementById('pdfPlatformFilter').value;
      const statusFilter = document.getElementById('pdfStatusFilter').value;

      filteredPDFs = allPDFs.filter(pdf => {
        const platformMatch = !platformFilter || pdf.platform === platformFilter;
        const statusMatch = !statusFilter || 
          (statusFilter === 'found' && pdf.found) || 
          (statusFilter === 'not-found' && !pdf.found);
        
        return platformMatch && statusMatch;
      });

      displayPDFs();
    }

    function displayPDFs() {
      const container = document.getElementById('pdfListContainer');
      const countEl = document.getElementById('pdfCount');

      if (filteredPDFs.length === 0) {
        container.innerHTML = '<p style="text-align: center; padding: 20px; color: #999;">No PDFs match the current filters.</p>';
        countEl.textContent = '';
        return;
      }

      countEl.textContent = `Showing ${filteredPDFs.length} of ${allPDFs.length} PDFs`;

      let html = '<div class="pdf-list">';

      filteredPDFs.forEach((result) => {
        const foundClass = result.found ? 'found' : '';
        const statusText = result.found ? 'FOUND' : 'NOT FOUND';
        const pdfUrl = result.pdfUrl || '';

        console.log('[DEBUG] Displaying PDF:', result.name, 'Platform:', result.platform, 'URL:', pdfUrl);

        html += `
          <div class="pdf-item ${foundClass}">
            <div class="pdf-name">
              <strong>${result.name}</strong>
              <span class="platform-badge">${result.platform.toUpperCase()}</span>
            </div>
            <span class="pdf-status ${foundClass}">${statusText}</span>
            <div class="pdf-actions">
              ${pdfUrl ? `
                <a href="${pdfUrl}" target="_blank" rel="noopener noreferrer" class="btn view">
                  View
                </a>
                <a href="${pdfUrl}" download class="btn download">
                  Download
                </a>
              ` : `<span class="no-pdf">PDF pending...</span>`}
            </div>
          </div>
        `;
      });

      html += '</div>';
      container.innerHTML = html;
    }

    async function loadAlertStats() {
      try {
        const response = await fetch('/api/upload/alerts/summary');
        const summary = await response.json();
        document.getElementById('totalAlerts').textContent = summary.totalAlerts || 0;
      } catch (error) {
        console.error('Error loading alerts:', error);
      }
    }

    // Load data on page load
    loadUploads();

    // Refresh uploads every 5 seconds
    setInterval(loadUploads, 5000);
  </script>
</body>
</html> -->



<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Compliance Screening Dashboard</title>
  <style>
